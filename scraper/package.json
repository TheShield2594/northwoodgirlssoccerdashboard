{
  "name": "northwood-scraper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "backfill": "tsx src/index.ts --backfill",
    "reparse": "tsx src/index.ts --backfill --from-cache",
    "verify": "tsx src/verify.ts",
    "capture": "tsx src/capture.ts",
    "inspect": "tsx src/inspect.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
